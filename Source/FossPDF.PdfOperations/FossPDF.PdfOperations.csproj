<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Authors>Samuel Kim, Silbiano Cruz, Eric Morris, Jerame Kim, FossPDF contributors</Authors>
        <Company>Santa Cruz County HSA</Company>
        <PackageId>FossPDF.PdfOperations</PackageId>
        <Version>2026.5.1</Version>
        <PackageDescription>Optional advanced PDF operations for FossPDF: page operations, overlays, encryption, attachments, XMP, qpdf optimization, tagged PDF, validated PDF/A-2/3, PDF/UA-1 and ZUGFeRD/Factur-X EN16931 packaging.</PackageDescription>
        <PackageReleaseNotes>Initial optional PDF operations companion package for FossPDF.</PackageReleaseNotes>
        <LangVersion>10</LangVersion>
        <TargetFramework>net9.0</TargetFramework>
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageReadmeFile>PackageReadme.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/samuelkim-scz/FossPDF.Net</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <Copyright>Samuel Kim and FossPDF contributors</Copyright>
        <PackageTags>pdf merge pages existing document operations tagged accessibility semantic structure foss</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\FossPDF\FossPDF.csproj" />
        <!-- Exact range: the reviewed cohort is PDFsharp 6.2.4 (MIT). The published 6.5.0 package
             declares AGPL-3.0-only; upgrading is a license decision. See ADR-0001 and
             NATIVE_DEPENDENCIES.md. -->
        <PackageReference Include="PDFsharp" Version="[6.2.4]" />
    </ItemGroup>

    <ItemGroup>
        <None Include="PackageReadme.md" Pack="true" PackagePath="\" />
        <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
        <None Include="..\..\docs\feature-parity\notices\PDFsharp-6.2.4-LICENSE.txt" Pack="true" PackagePath="licenses\" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="FossPDF.UnitTests" />
        <InternalsVisibleTo Include="FossPDF.Examples" />
    </ItemGroup>
</Project>
