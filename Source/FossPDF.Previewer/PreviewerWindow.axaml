<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:FossPDF.Previewer"
        x:Class="FossPDF.Previewer.PreviewerWindow"
        x:DataType="p:PreviewerWindowViewModel" x:CompileBindings="True"
        WindowStartupLocation="CenterScreen" Width="1300" Height="850" MinWidth="900" MinHeight="600"
        Background="#252930" Icon="/Resources/Logo.png" UseLayoutRounding="True"
        Title="FossPDF Document Preview">
  <Window.Styles>
    <Style Selector="Button"><Setter Property="Padding" Value="12,6" /></Style>
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="#E5EAF0" /></Style>
    <Style Selector="SelectableTextBlock"><Setter Property="Foreground" Value="#E5EAF0" /></Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,380">
    <Border Grid.ColumnSpan="2" Background="#191D23" Padding="16,10">
      <WrapPanel Orientation="Horizontal">
        <TextBlock Text="FossPDF" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Margin="0,0,22,0" />
        <ComboBox ItemsSource="{x:Static p:InspectionViewModel.Tools}" SelectedItem="{Binding Inspector.Tool, Mode=TwoWay}"
                  AutomationProperties.Name="Inspection tool" MinWidth="195" Margin="0,0,12,0" />
        <CheckBox Content="3× magnifier" IsChecked="{Binding Inspector.Magnify, Mode=TwoWay}" Margin="0,0,20,0" />
        <Button Content="Open PDF" Command="{Binding ShowPdfCommand}" IsEnabled="{Binding !!Pages.Count}" Margin="0,0,8,0" />
        <Button Content="Documentation" Command="{Binding ShowDocumentationCommand}" />
      </WrapPanel>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Background="#666">
      <p:PreviewerControl Pages="{Binding Pages}" Inspector="{Binding Inspector}"
                          CurrentScroll="{Binding CurrentScroll, Mode=TwoWay}"
                          ScrollViewportSize="{Binding ScrollViewportSize, Mode=OneWayToSource}"
                          AutomationProperties.Name="Document canvas. Arrow keys pan, plus and minus zoom." />
      <ScrollBar Grid.Column="1" Orientation="Vertical" AllowAutoHide="False" Minimum="0" Maximum="1"
                 IsVisible="{Binding VerticalScrollbarVisible}" Value="{Binding CurrentScroll, Mode=TwoWay}"
                 ViewportSize="{Binding ScrollViewportSize}" AutomationProperties.Name="Document scroll" />
    </Grid>
    <Border Grid.Row="1" Grid.Column="1" Padding="14" Background="#252930">
      <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
        <StackPanel Spacing="6">
          <TextBlock Text="INSPECT DOCUMENT" FontWeight="Bold" FontSize="13" />
          <TextBox Watermark="Search text, labels, types or configuration" Text="{Binding Inspector.Query, Mode=TwoWay}"
                   AutomationProperties.Name="Search document" />
          <TextBlock Text="{Binding Inspector.SearchStatus}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,8">
          <Button Content="Expand / collapse" Click="ToggleHierarchy" />
          <Button Content="Parent" Click="SelectParent" />
        </StackPanel>
        <ListBox x:Name="ElementHierarchy" Grid.Row="2" ItemsSource="{Binding Inspector.Entries}" SelectedItem="{Binding Inspector.Selected, Mode=TwoWay}"
                 AutomationProperties.Name="Element hierarchy and search results">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="p:InspectionEntry">
              <StackPanel Margin="{Binding Indent}" Spacing="2">
                <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Description}" FontSize="10" Opacity="0.7" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ScrollViewer Grid.Row="3" MaxHeight="260" Margin="0,12,0,0">
          <StackPanel Spacing="8">
            <SelectableTextBlock Text="{Binding Inspector.Details}" TextWrapping="Wrap" FontSize="12" />
            <ComboBox ItemsSource="{Binding Inspector.Occurrences}" SelectedItem="{Binding Inspector.SelectedOccurrence, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" AutomationProperties.Name="Selected element occurrence" />
            <SelectableTextBlock Text="{Binding Inspector.OccurrenceDetails}" TextWrapping="Wrap" FontSize="12" />
            <SelectableTextBlock Text="{Binding Inspector.SourceLocation}" TextWrapping="Wrap" FontSize="11" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="Open source" Click="OpenSource" IsEnabled="{Binding Inspector.HasSource}" />
              <Button Content="Copy location" Click="CopyLocation" IsEnabled="{Binding Inspector.HasSource}" />
            </StackPanel>
            <TextBlock Text="Point coordinates" FontWeight="Bold" FontSize="12" />
            <Grid ColumnDefinitions="64,*,*,Auto" ColumnSpacing="6">
              <TextBox MinWidth="0" Text="{Binding Inspector.CoordinatePage, Mode=TwoWay}" AutomationProperties.Name="Coordinate page" Watermark="Page" />
              <TextBox Grid.Column="1" MinWidth="0" Text="{Binding Inspector.CoordinateX, Mode=TwoWay}" AutomationProperties.Name="Coordinate X in points" Watermark="X pt" />
              <TextBox Grid.Column="2" MinWidth="0" Text="{Binding Inspector.CoordinateY, Mode=TwoWay}" AutomationProperties.Name="Coordinate Y in points" Watermark="Y pt" />
              <Button Grid.Column="3" Content="Pick" Click="PickCoordinates" />
            </Grid>
            <SelectableTextBlock Text="{Binding Inspector.MeasurementText}" TextWrapping="Wrap" FontSize="12" />
          </StackPanel>
        </ScrollViewer>
        <Expander Grid.Row="4" Header="Runtime / layout diagnostic" IsVisible="{Binding Inspector.HasDiagnostic}" MaxHeight="180">
          <ScrollViewer>
            <StackPanel Spacing="8">
              <Button Content="Find exception text" Click="FindDiagnostic" />
              <SelectableTextBlock Text="{Binding Inspector.Diagnostic}" TextWrapping="Wrap" FontSize="11" />
            </StackPanel>
          </ScrollViewer>
        </Expander>
      </Grid>
    </Border>
    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#191D23" Padding="16,8">
      <StackPanel Spacing="3">
        <TextBlock Text="{Binding Inspector.Pointer}" FontSize="12" />
        <TextBlock Text="{Binding Inspector.Status}" TextWrapping="Wrap" FontSize="12" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
