<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
        <IsPackable>false</IsPackable>
        <LangVersion>10</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentAssertions" Version="6.12.0" />
        <PackageReference Include="nunit" Version="3.13.3" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
        <PackageReference Include="SkiaSharp" Version="3.119.4" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
        <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.5" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\FossPDF\FossPDF.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
      <ProjectReference Include="..\FossPDF.Previewer\FossPDF.Previewer.csproj" />
      <ProjectReference Include="..\FossPDF.FontSubset.Glue\FossPDF.FontSubset.Glue.csproj" />
      <!-- The SVG companion targets net9.0 only; the tests are conditional on the framework. -->
      <ProjectReference Include="..\FossPDF.Svg\FossPDF.Svg.csproj" />
      <!-- The PDF operations companion targets net9.0 only; the tests are conditional on the framework. -->
      <ProjectReference Include="..\FossPDF.PdfOperations\FossPDF.PdfOperations.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\..\docs\feature-parity\acceptance-fixtures.json" Link="Parity\acceptance-fixtures.json" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="..\..\docs\feature-parity\baseline-2026.9.1.json" Link="Parity\baseline-2026.9.1.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="Resources\EInvoice\*" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="Resources\AccessibilityReview\*" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="Resources\FontContent.ttf">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <EmbeddedResource Include="Resources\FontEmbeddedResource.ttf">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <!-- Subset Noto fonts used by the complex-script corpus; see Resources/ComplexScripts/README.md. -->
      <EmbeddedResource Include="Resources\ComplexScripts\*.ttf" />
    </ItemGroup>

</Project>
