<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Authors>Samuel Kim, Silbiano Cruz, Eric Morris, Jerame Kim, FossPDF contributors</Authors>
        <Company>Santa Cruz County HSA</Company>
        <Version>2026.5.1</Version>
        <RepositoryUrl>https://github.com/samuelkim-scz/FossPDF.Net</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>PackageReadme.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SkiaSharp.HarfBuzz" Version="3.119.4" />
        <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.5"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="Resources\PackageReadme.md" Pack="true" PackagePath="\" />
        <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
